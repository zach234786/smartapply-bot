  <Sequence sap2010:Annotation.AnnotationText="builds and sends the summary email. this is the stage that tells the user what the bot actually did on their behalf" DisplayName="SendOutlook - Email Application Summary" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ApplicantName" />
      <Variable x:TypeArguments="x:String" Name="SkillsText" />
      <Variable x:TypeArguments="x:String" Name="ApplicationRowsHtml" />
      <Variable x:TypeArguments="x:String" Name="EmailBody" />
      <Variable x:TypeArguments="x:Boolean" Default="False" Name="AttachmentExists" />
      <Variable x:TypeArguments="scg:List(x:String)" Default="[New List(Of String)]" Name="ValidAttachments" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="JobApplicationCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <TryCatch sap2010:Annotation.AnnotationText="the email is the last stage, so a failure here must not undo the applications that were already submitted and logged. everything is caught, recorded and swallowed rather than rethrown" DisplayName="Try Catch - Outlook Email" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <TryCatch.Try>
        <Sequence sap2010:Annotation.AnnotationText="builds the body, then sends. the build is done first so a formatting mistake fails before any mail goes out" DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign sap2010:Annotation.AnnotationText="name for the greeting line, falling back to a generic word if the resume never yielded one so the email still reads properly" DisplayName="Assign - Applicant Name" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicantName]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;Name&quot;).ToString(), &quot;Applicant&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="the skills the ranking was based on, repeated in the email so the user can see why these jobs were picked" DisplayName="Assign - Matched Skills Text" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[SkillsText]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;SkillsMatched&quot;).ToString(), &quot;none recorded&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="counted once here rather than repeatedly inside the html so the subject line and the body can never disagree" DisplayName="Assign - Application Count" sap2010:WorkflowViewState.IdRef="Assign_3">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[JobApplicationCount]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[If(JobApplicationsIn Is Nothing, 0, JobApplicationsIn.Rows.Count)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="builds one html table row per submitted application using a linq select over the datatable, so the whole table is a single expression. falls back to one placeholder row when nothing was submitted" DisplayName="Assign - Build Application Table Rows" sap2010:WorkflowViewState.IdRef="Assign_4">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicationRowsHtml]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(JobApplicationsIn Is Nothing OrElse JobApplicationsIn.Rows.Count = 0, &quot;&lt;tr&gt;&lt;td colspan='5' style='padding:8px;border:1px solid #d8dbd3;color:#5b655f;'&gt;No applications were submitted on this run.&lt;/td&gt;&lt;/tr&gt;&quot;, String.Join(&quot;&quot;, JobApplicationsIn.AsEnumerable().Select(Function(r) &quot;&lt;tr&gt;&quot; &amp; &quot;&lt;td style='padding:8px;border:1px solid #d8dbd3;'&gt;&quot; &amp; r(&quot;JobTitle&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot; &amp; &quot;&lt;td style='padding:8px;border:1px solid #d8dbd3;'&gt;&quot; &amp; r(&quot;Company&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot; &amp; &quot;&lt;td style='padding:8px;border:1px solid #d8dbd3;font-family:Consolas,monospace;'&gt;&quot; &amp; r(&quot;Salary&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot; &amp; &quot;&lt;td style='padding:8px;border:1px solid #d8dbd3;font-family:Consolas,monospace;'&gt;&quot; &amp; r(&quot;ReferenceNo&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot; &amp; &quot;&lt;td style='padding:8px;border:1px solid #d8dbd3;'&gt;&quot; &amp; r(&quot;Status&quot;).ToString() &amp; &quot;&lt;/td&gt;&quot; &amp; &quot;&lt;/tr&gt;&quot;)))]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="filters the letters down to the ones that are really on disk instead of trusting the paths it was handed. a letter the word stage recorded but that has since been moved or deleted would otherwise fail the whole send, so it is dropped here and the rest still go out" DisplayName="Assign - Collect Existing Cover Letters" sap2010:WorkflowViewState.IdRef="Assign_5a">
            <Assign.To>
              <OutArgument x:TypeArguments="scg:List(x:String)">[ValidAttachments]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="scg:List(x:String)">[If(CoverLetterPathsIn Is Nothing, New List(Of String), CoverLetterPathsIn.Where(Function(p) Not String.IsNullOrWhiteSpace(p) AndAlso System.IO.File.Exists(p)).ToList())]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="one flag rather than repeating the count test, so the branch below and any future check can never disagree about whether there is anything to attach" DisplayName="Assign - Check Cover Letter Attachment" sap2010:WorkflowViewState.IdRef="Assign_5">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[AttachmentExists]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[ValidAttachments.Count &gt; 0]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="assembles the formatted html body with an inline styled results table. html rather than plain text so the summary is readable at a glance in outlook" DisplayName="Assign - Build HTML Email Body" sap2010:WorkflowViewState.IdRef="Assign_6">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[EmailBody]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[&quot;&lt;html&gt;&lt;body style='font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1c2321;'&gt;&quot; &amp; &quot;&lt;h2 style='color:#35604f;margin-bottom:2px;'&gt;SmartApply Bot &amp;mdash; Application Summary&lt;/h2&gt;&quot; &amp; &quot;&lt;p style='color:#5b655f;margin-top:0;font-size:12px;'&gt;Run completed &quot; &amp; DateTime.Now.ToString(&quot;d MMMM yyyy, HH:mm&quot;) &amp; &quot;&lt;/p&gt;&quot; &amp; &quot;&lt;p&gt;Hello &quot; &amp; ApplicantName &amp; &quot;,&lt;/p&gt;&quot; &amp; &quot;&lt;p&gt;The following &quot; &amp; JobApplicationCount.ToString() &amp; &quot; application(s) were submitted on your behalf on the Foothold job board:&lt;/p&gt;&quot; &amp; &quot;&lt;table style='border-collapse:collapse;border:1px solid #d8dbd3;font-size:13px;'&gt;&quot; &amp; &quot;&lt;tr style='background:#35604f;color:#ffffff;text-align:left;'&gt;&quot; &amp; &quot;&lt;th style='padding:8px;'&gt;Job Title&lt;/th&gt;&lt;th style='padding:8px;'&gt;Company&lt;/th&gt;&quot; &amp; &quot;&lt;th style='padding:8px;'&gt;Salary&lt;/th&gt;&lt;th style='padding:8px;'&gt;Reference&lt;/th&gt;&quot; &amp; &quot;&lt;th style='padding:8px;'&gt;Status&lt;/th&gt;&lt;/tr&gt;&quot; &amp; ApplicationRowsHtml &amp; &quot;&lt;/table&gt;&quot; &amp; &quot;&lt;p style='margin-top:18px;'&gt;Skills matched from your resume: &lt;b&gt;&quot; &amp; SkillsText &amp; &quot;&lt;/b&gt;&lt;/p&gt;&quot; &amp; If(ValidAttachments.Count &gt; 0, &quot;&lt;p&gt;&lt;b&gt;&quot; &amp; ValidAttachments.Count.ToString() &amp; &quot;&lt;/b&gt; tailored cover letter(s) are attached, one per application.&lt;/p&gt;&quot;, &quot;&quot;) &amp;&quot;&lt;p style='color:#8a9389;font-size:12px;margin-top:24px;'&gt;Sent automatically by SmartApply Bot. A full log of this run is saved in extraction_log.xlsx.&lt;/p&gt;&quot; &amp; &quot;&lt;/body&gt;&lt;/html&gt;&quot;]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <If sap2010:Annotation.AnnotationText="two send activities rather than one because the attachments property cannot be conditionally emptied, so the branch decides whether the cover letter travels with the email" Condition="[AttachmentExists]" DisplayName="If - Attach Cover Letter" sap2010:WorkflowViewState.IdRef="If_1">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <If.Then>
              <Sequence sap2010:Annotation.AnnotationText="the pdf exists on disk so it travels with the email" DisplayName="Then - Send With Cover Letter" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:SendOutlookMail Bcc="{x:Null}" Cc="{x:Null}" MailMessage="{x:Null}" ReplyTo="{x:Null}" SentOnBehalfOfName="{x:Null}" TimeoutMS="{x:Null}" Account="zachgan101@gmail.com" sap2010:Annotation.AnnotationText="sends the summary through the desktop outlook account with every generated cover letter attached. attachmentscollection is used rather than the files property because files is a fixed list fixed at design time, while the number of letters is only known at runtime once the user has decided how many jobs to apply for" AttachmentsCollection="[ValidAttachments]" Body="[EmailBody]" DisplayName="Send Outlook Mail Message - With Cover Letters" Importance="Normal" IsBodyHtml="True" IsDraft="False" Sensitivity="Normal" Subject="[&quot;SmartApply Bot - &quot; &amp; JobApplicationCount.ToString() &amp; &quot; job application(s) submitted on &quot; &amp; DateTime.Now.ToString(&quot;d MMM yyyy&quot;)]" To="[RecipientEmailIn]" sap2010:WorkflowViewState.IdRef="SendOutlookMail_1">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                </ui:SendOutlookMail>
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence sap2010:Annotation.AnnotationText="no letter was produced, so the summary goes out on its own rather than not at all" DisplayName="Else - Send Without Cover Letter" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:SendOutlookMail Bcc="{x:Null}" Cc="{x:Null}" MailMessage="{x:Null}" ReplyTo="{x:Null}" SentOnBehalfOfName="{x:Null}" TimeoutMS="{x:Null}" Account="zachgan101@gmail.com" sap2010:Annotation.AnnotationText="the same email minus the attachment, used when the word stage was skipped or failed so the user still gets their summary" Body="[EmailBody]" DisplayName="Send Outlook Mail Message - Summary Only" Importance="Normal" IsBodyHtml="True" IsDraft="False" Sensitivity="Normal" Subject="[&quot;SmartApply Bot - &quot; &amp; JobApplicationCount.ToString() &amp; &quot; job application(s) submitted on &quot; &amp; DateTime.Now.ToString(&quot;d MMM yyyy&quot;)]" To="[RecipientEmailIn]" sap2010:WorkflowViewState.IdRef="SendOutlookMail_2">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                </ui:SendOutlookMail>
              </Sequence>
            </If.Else>
          </If>
          <ui:LogMessage sap2010:Annotation.AnnotationText="confirms the email went out and how many applications it covered" DisplayName="Log Message - Summary Email Sent" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;INF_601 | SendOutlook | Summary email sent to &quot; &amp; RecipientEmailIn &amp; &quot; covering &quot; &amp; JobApplicationCount.ToString() &amp; &quot; application(s)&quot;]">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </ui:LogMessage>
          <ui:AddDataRow DataRow="{x:Null}" sap2010:Annotation.AnnotationText="records the send in the runlog so the excel output shows the process ran all the way to the end" ArrayRow="[{DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;), &quot;SendOutlook&quot;, &quot;Send Summary&quot;, &quot;SUCCESS&quot;, &quot;Email&quot;, &quot;Summary email sent to &quot; &amp; RecipientEmailIn}]" DataTable="[RunLog]" DisplayName="Add Data Row - Log Email Sent" sap2010:WorkflowViewState.IdRef="AddDataRow_1">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </ui:AddDataRow>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
            </ActivityAction.Argument>
            <Sequence sap2010:Annotation.AnnotationText="records the failure so there is a trace that the user was never notified" DisplayName="Catch - Email Send Failed" sap2010:WorkflowViewState.IdRef="Sequence_5">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <ui:LogMessage sap2010:Annotation.AnnotationText="err_601 usually means outlook is not running or not signed in. logged rather than rethrown because the applications were already submitted and the excel log already written" DisplayName="Log Message - Email Send Failed" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Error" Message="[&quot;ERR_601 | SendOutlook | &quot; &amp; ex.Message]">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
              </ui:LogMessage>
              <ui:AddDataRow DataRow="{x:Null}" sap2010:Annotation.AnnotationText="keeps the failure in the runlog so there is a record that the user was never notified" ArrayRow="[{DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;), &quot;SendOutlook&quot;, &quot;Send Summary&quot;, &quot;ERROR&quot;, &quot;Email&quot;, &quot;ERR_601 | &quot; &amp; ex.Message}]" DataTable="[RunLog]" DisplayName="Add Data Row - Log Email Failure" sap2010:WorkflowViewState.IdRef="AddDataRow_2">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
              </ui:AddDataRow>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
      <TryCatch.Finally>
        <Sequence sap2010:Annotation.AnnotationText="nothing to release. outlook is driven through its own interop and closes itself" DisplayName="Finally" sap2010:WorkflowViewState.IdRef="Sequence_6">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
        </Sequence>
      </TryCatch.Finally>
    </TryCatch>
  </Sequence>
</Activity>
