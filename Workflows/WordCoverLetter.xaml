  <Sequence sap2010:Annotation.AnnotationText="the word stage. takes the jobs that were actually submitted and turns the template into one finished cover letter per job, so the user has a tailored letter for every application instead of writing each one by hand" DisplayName="WordCoverLetter - Generate Cover Letters" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="" Name="OutputFolder" />
      <Variable x:TypeArguments="x:String" Default="" Name="ApplicantName" />
      <Variable x:TypeArguments="x:String" Default="" Name="ApplicantEmail" />
      <Variable x:TypeArguments="x:String" Default="" Name="ApplicantPhone" />
      <Variable x:TypeArguments="x:String" Default="" Name="ApplicantSkills" />
      <Variable x:TypeArguments="x:String" Default="" Name="LetterDate" />
      <Variable x:TypeArguments="scg:List(x:String)" Default="[New List(Of String)]" Name="GeneratedLetters" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="LetterCount" />
      <Variable x:TypeArguments="scg:List(sd:DataRow)" Name="SubmittedJobs" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <TryCatch sap2010:Annotation.AnnotationText="the whole word stage is wrapped so a failure here can never cost the user their email or their excel log. the letters are a bonus on top of the applications that were already submitted, so this stage records what went wrong and lets the process carry on" DisplayName="Try Catch - Word Cover Letter Stage" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <TryCatch.Try>
        <Sequence sap2010:Annotation.AnnotationText="reads the applicant details once, then writes one letter per submitted job" DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign sap2010:Annotation.AnnotationText="creates the cover letters folder and hands back its full path in one step. createdirectory is safe to call when the folder already exists, so a second run does not fail here" DisplayName="Assign - Create Output Folder" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[OutputFolder]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[System.IO.Directory.CreateDirectory(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), &quot;Output (Cover Letters)&quot;)).FullName]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="the name for the letterhead and the signoff, falling back to a generic word so a missing name never leaves a raw placeholder in the finished letter" DisplayName="Assign - Applicant Name" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicantName]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;Name&quot;).ToString(), &quot;Applicant&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="contact email for the letterhead and the closing paragraph" DisplayName="Assign - Applicant Email" sap2010:WorkflowViewState.IdRef="Assign_3">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicantEmail]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;Email&quot;).ToString(), &quot;&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="contact number for the letterhead" DisplayName="Assign - Applicant Phone" sap2010:WorkflowViewState.IdRef="Assign_4">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicantPhone]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;Phone&quot;).ToString(), &quot;&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="the same skills string the ranking was based on, so the letter argues the case using the exact skills that won the job its place in the shortlist" DisplayName="Assign - Applicant Skills" sap2010:WorkflowViewState.IdRef="Assign_5">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[ApplicantSkills]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(ApplicantProfileIn IsNot Nothing AndAlso ApplicantProfileIn.Rows.Count &gt; 0, ApplicantProfileIn.Rows(0)(&quot;SkillsMatched&quot;).ToString(), &quot;a range of relevant skills&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="dated once before the loop so every letter in a single run carries the same date" DisplayName="Assign - Letter Date" sap2010:WorkflowViewState.IdRef="Assign_6">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[LetterDate]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[DateTime.Now.ToString(&quot;d MMMM yyyy&quot;)]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="filters the applications down to the ones that actually went through. a job the user declined at the confirm prompt gets no letter, so the folder only ever holds letters the user can really send" DisplayName="Assign - Select Submitted Jobs" sap2010:WorkflowViewState.IdRef="Assign_7">
            <Assign.To>
              <OutArgument x:TypeArguments="scg:List(sd:DataRow)">[SubmittedJobs]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="scg:List(sd:DataRow)">[If(JobApplicationsIn Is Nothing, New List(Of System.Data.DataRow), JobApplicationsIn.Select(&quot;Status = 'Submitted'&quot;).ToList())]</InArgument>
            </Assign.Value>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
          </Assign>
          <If sap2010:Annotation.AnnotationText="the template is the one thing this stage cannot work without, so it is checked before word is ever opened. a missing template is reported as a warning and the process carries on rather than throwing" Condition="[System.IO.File.Exists(TemplatePathIn)]" DisplayName="If - Template Exists" sap2010:WorkflowViewState.IdRef="If_1">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <If.Then>
              <Sequence sap2010:Annotation.AnnotationText="template found, so one letter is produced for each submitted job" DisplayName="Then - Generate Letters" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="one pass per submitted job. each pass copies the template and fills the copy, so the template itself is never touched and the bot can be run again and again without the placeholders being used up" DisplayName="For Each Submitted Job - Write Cover Letter" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[SubmittedJobs]">
                  <ui:ForEach.Body>
                    <ActivityAction x:TypeArguments="sd:DataRow">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="sd:DataRow" Name="job" />
                      </ActivityAction.Argument>
                      <Sequence sap2010:Annotation.AnnotationText="everything needed to turn the template into one finished letter for this particular job" DisplayName="Body - One Cover Letter" sap2010:WorkflowViewState.IdRef="Sequence_4">
                        <Sequence.Variables>
                          <Variable x:TypeArguments="x:String" Default="" Name="LetterPath" />
                          <Variable x:TypeArguments="x:String" Default="" Name="SafeCompany" />
                          <Variable x:TypeArguments="x:String" Default="" Name="SafeReference" />
                        </Sequence.Variables>
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <TryCatch sap2010:Annotation.AnnotationText="each letter gets its own handler so one company name that word chokes on cannot stop the remaining letters from being written" DisplayName="Try Catch - Single Letter" sap2010:WorkflowViewState.IdRef="TryCatch_2">
                          <sap:WorkflowViewStateService.ViewState>
                            <scg:Dictionary x:TypeArguments="x:String, x:Object">
                              <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                            </scg:Dictionary>
                          </sap:WorkflowViewStateService.ViewState>
                          <TryCatch.Try>
                            <Sequence sap2010:Annotation.AnnotationText="copy the template, then fill the copy in word" DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_5">
                              <sap:WorkflowViewStateService.ViewState>
                                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                </scg:Dictionary>
                              </sap:WorkflowViewStateService.ViewState>
                              <Assign sap2010:Annotation.AnnotationText="strips out anything that is not a letter or a digit so a company name like o'brien and co. cannot produce an illegal filename" DisplayName="Assign - Safe Company Name" sap2010:WorkflowViewState.IdRef="Assign_8">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:String">[SafeCompany]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(job(&quot;Company&quot;).ToString(), &quot;[^A-Za-z0-9]&quot;, &quot;&quot;)]</InArgument>
                                </Assign.Value>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </Assign>
                              <Assign sap2010:Annotation.AnnotationText="the foothold reference number cleaned the same way, so every letter has a filename that ties it back to a specific application" DisplayName="Assign - Safe Reference Number" sap2010:WorkflowViewState.IdRef="Assign_9">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:String">[SafeReference]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(job(&quot;ReferenceNo&quot;).ToString(), &quot;[^A-Za-z0-9]&quot;, &quot;&quot;)]</InArgument>
                                </Assign.Value>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </Assign>
                              <Assign sap2010:Annotation.AnnotationText="names the letter after the company and the reference so the user can tell at a glance which letter belongs to which application" DisplayName="Assign - Letter File Path" sap2010:WorkflowViewState.IdRef="Assign_10">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:String">[LetterPath]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(OutputFolder, &quot;CoverLetter_&quot; &amp; SafeCompany &amp; &quot;_&quot; &amp; SafeReference &amp; &quot;.docx&quot;)]</InArgument>
                                </Assign.Value>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </Assign>
                              <ui:CopyFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="works on a copy rather than the template itself. this is what makes the stage repeatable, because replacing text is destructive and a template whose placeholders had been overwritten would be useless on the next run" Destination="[LetterPath]" DisplayName="Copy File - Template to New Letter" Overwrite="True" Path="[TemplatePathIn]" sap2010:WorkflowViewState.IdRef="CopyFile_1">
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </ui:CopyFile>
                              <Sequence sap2010:Annotation.AnnotationText="swaps every placeholder token in the copied letter for the real value. these are the file based word activities rather than the interop ones, so no winword process is started and the stage cannot be broken by word already being open. the tokens are double braced so they cannot collide with ordinary words in the letter" DisplayName="Sequence - Fill Placeholders" sap2010:WorkflowViewState.IdRef="Sequence_6">
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="the applicant name, which appears in both the letterhead and the signoff" DisplayName="Replace Text - Name" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_1">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{Name}}&quot;]</InArgument>
                                </uw:DocumentReplaceText.Search>
                                <uw:DocumentReplaceText.Replace>
                                  <InArgument x:TypeArguments="x:String">[ApplicantName]</InArgument>
                                </uw:DocumentReplaceText.Replace>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </uw:DocumentReplaceText>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="appears in the letterhead and again in the closing paragraph as a contact route" DisplayName="Replace Text - Email" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_2">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{Email}}&quot;]</InArgument>
                                </uw:DocumentReplaceText.Search>
                                <uw:DocumentReplaceText.Replace>
                                  <InArgument x:TypeArguments="x:String">[ApplicantEmail]</InArgument>
                                </uw:DocumentReplaceText.Replace>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </uw:DocumentReplaceText>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="the contact number from the resume" DisplayName="Replace Text - Phone" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_3">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{Phone}}&quot;]</InArgument>
                                </uw:DocumentReplaceText.Search>
                                <uw:DocumentReplaceText.Replace>
                                  <InArgument x:TypeArguments="x:String">[ApplicantPhone]</InArgument>
                                </uw:DocumentReplaceText.Replace>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </uw:DocumentReplaceText>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="dates the letter so it reads as written on the day the application went out" DisplayName="Replace Text - Date" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_4">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{Date}}&quot;]</InArgument>
                                </uw:DocumentReplaceText.Search>
                                <uw:DocumentReplaceText.Replace>
                                  <InArgument x:TypeArguments="x:String">[LetterDate]</InArgument>
                                </uw:DocumentReplaceText.Replace>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </uw:DocumentReplaceText>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="the company is what makes each letter specific rather than generic. it appears three times in the template, in the address block and twice in the body" DisplayName="Replace Text - Company" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_5">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{Company}}&quot;]</InArgument>
                                </uw:DocumentReplaceText.Search>
                                <uw:DocumentReplaceText.Replace>
                                  <InArgument x:TypeArguments="x:String">[job(&quot;Company&quot;).ToString()]</InArgument>
                                </uw:DocumentReplaceText.Replace>
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                              </uw:DocumentReplaceText>
                              <uw:DocumentReplaceText sap2010:Annotation.AnnotationText="the exact job title as it appeared on the listing, so the letter names the role the user actually applied for" DisplayName="Replace Text - JobTitle" FilePath="[LetterPath]" sap2010:WorkflowViewState.IdRef="DocumentReplaceText_6">
                                <uw:DocumentReplaceText.Search>
                                  <InArgument x:TypeArguments="x:String">[&quot;{{JobTitle}}&quot;]</InArgument>
