  <Sequence sap2010:Annotation.AnnotationText="appends the applications this run submitted to the excel log and flushes the run log, so the workbook ends up as the complete record of what happened" DisplayName="LogtoExcel - Record Submitted Applications" sap2010:WorkflowViewState.IdRef="Sequence_1">
